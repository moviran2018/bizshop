{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run local server (port 3000)",
      "type": "shell",
      "command": "node _server.js",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy to Cloudflare Pages",
      "type": "shell",
      "command": "npx wrangler pages deploy . --project-name bizshop",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
